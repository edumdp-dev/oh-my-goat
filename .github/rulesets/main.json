{
  "name": "ohmg-main-protected",
  "target": "branch",
  "source_type": "Repository",
  "enforcement": "active",
  "applied_via": "POST /repos/edumdp-dev/oh-my-goat/rulesets (ruleset ids 22244891 main / 22244892 tags)",
  "_comment": "Apply via POST /repos/edumdp-dev/oh-my-goat/rulesets ONLY after the first green OhMyGoat CI / verify on main (bootstrap exemption). Owner bypass via RepositoryRole.",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "refs/heads/main"
      ]
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict": false,
        "required_status_checks": [
          {
            "context": "OhMyGoat CI / verify",
            "integration_id": null
          }
        ]
      }
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "automatic_approve_if_new_commits_pushed": false
      }
    }
  ],
  "bypass_actors": [
    {
      "actor_type": "RepositoryRole",
      "actor_id": 5,
      "bypass_mode": "always"
    }
  ]
}
